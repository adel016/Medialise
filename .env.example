# Copiez ce fichier en ".env" (à la racine) et remplissez vos propres valeurs.
# Ce fichier est utilisé par docker-compose (configuration/docker-compose.yml)
# ainsi que par les scripts scrapers/ et frontend_backend/ (python-dotenv).
# Ne jamais commiter le fichier ".env" réel : il est ignoré via .gitignore.

# === Flask ===
FLASK_ENV=development
SECRET_KEY=changez-moi-en-production

# === MongoDB ===
# En local (hors Docker) : mongodb://localhost:27017/medicsearch
# Dans docker-compose, la valeur est surchargée automatiquement (mongodb://mongo:27017/medicsearch)
MONGO_URI=mongodb://localhost:27017/medicsearch
MONGO_DB=medicsearch

# === Environnement ===
ENV=local
DEBUG=true

# === Qdrant ===
# Dans docker-compose : QDRANT_HOST=qdrant
# En local (hors Docker) : QDRANT_HOST=localhost
QDRANT_HOST=localhost
QDRANT_PORT=6333

# === Mistral AI ===
# Clé gratuite sur https://console.mistral.ai/
MISTRAL_API_KEY=votre_cle_api_mistral

# === Thériaque (scraping) ===
# Cookie de session obtenu via F12 -> Application -> Cookies, une fois connecté sur theriaque.org
THERIAQUE_PHPSESSID=votre_phpsessid
THERIAQUE_AUTHCHALLENGE=votre_authchallenge

# === Neo4j ===
NEO4J_URI=bolt://localhost:17687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changez-moi
NEO4J_DATABASE=neo4j
