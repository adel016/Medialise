# Configuration de la base de données MongoDB
MONGO_URI=mongodb://localhost:27017/medicsearch

# Clé secrète pour Flask (générez une clé aléatoire pour la production)
SECRET_KEY=e8b7c9d2f5a3b1e4c6d8f0a9b2e7d5c1

# Configuration de l'IA - Mistral
# Obtenez votre clé API gratuite sur https://console.mistral.ai/
MISTRAL_API_KEY=votre_clé_api_mistral_ici

# Configuration des logs
LOG_LEVEL=INFO

# Configuration du cache
CACHE_TYPE=simple

# Configuration des cookies (production)
SESSION_COOKIE_SECURE=False
